# Copy to apps/ai/.env and fill in. Get values from Supabase → Settings → API.
# These are SERVER-ONLY secrets — never expose them to the browser.

SUPABASE_URL=https://eqfcxhdkvtgjetczzeod.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

WEB_ORIGIN=http://localhost:3000

# AI mode. true (default) = free mock streaming. Set false to call real providers.
USE_MOCK_AI=true

# AI provider keys. Fill only the ones you use; blank ones fall back to mock.
# Tip: Google Gemini has a free tier — get a key at aistudio.google.com.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Generation limits (optional; defaults shown).
# MAX_INPUT_TOKENS=4096           # context trimmed to this before the call
# MAX_OUTPUT_TOKENS=4096          # cap on tokens the model may generate
# PROVIDER_TIMEOUT_SECONDS=120          # OpenAI/Anthropic: max gap between stream chunks
# PROVIDER_STREAM_DEADLINE_SECONDS=540  # Gemini: whole-call deadline (keep < Cloud Run's 600)

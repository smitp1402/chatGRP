# Copy this file to .env.local and fill in the values.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://eqfcxhdkvtgjetczzeod.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# service_role key — SERVER ONLY (used by Stripe webhooks to update plans).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# FastAPI AI service
NEXT_PUBLIC_AI_URL=http://localhost:8000

# App URL used for Stripe redirect targets (local dev shown)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Dashboard → Developers → API keys; test mode)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID from your Stripe product (Products → your product → Pricing)
STRIPE_PRICE_PRO=price_...

# PostHog product analytics (optional — unset disables all tracking)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
